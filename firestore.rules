rules_version = '2';

// Doodle's Playhouse leaderboard. Paste this into Firebase console → Firestore Database → Rules.
// One collection per difficulty (runs_practice, runs_easy, runs_normal, runs_hard), so the
// "order by seconds" query needs no composite index. Anyone may read and add a run; nobody may
// change or delete one (do that yourself in the console). The checks mirror
// src/leaderboard/entries.js, so a hand-made request can't post a malformed or impossible run.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{board}/{runId} {
      allow read: if board in ['runs_practice', 'runs_easy', 'runs_normal', 'runs_hard'];
      allow create: if board in ['runs_practice', 'runs_easy', 'runs_normal', 'runs_hard']
        && request.resource.data.keys().hasOnly(['name', 'seconds', 'days', 'route', 'v'])
        && request.resource.data.keys().hasAll(['name', 'seconds', 'days', 'route', 'v'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9]{1,6}$')
        && request.resource.data.seconds is number
        && request.resource.data.seconds >= 60
        && request.resource.data.seconds < 86400
        && request.resource.data.days is int
        && request.resource.data.days >= 1
        && request.resource.data.days <= 5
        && request.resource.data.route in ['frontDoor', 'garage']
        && request.resource.data.v == 1;
      allow update, delete: if false;
    }
  }
}
